{
  "app-id": "com.github.kinema.Kinema",
  "runtime": "org.gnome.Platform",
  "runtime-version": "46",
  "sdk": "org.gnome.Sdk",
  "command": "kinema",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--socket=pulseaudio",
    "--share=network",
    "--talk-name=org.freedesktop.Notifications",
    "--filesystem=xdg-cache/kinema:create",
    "--filesystem=xdg-data/kinema:create"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "luajit",
      "no-autogen": true,
      "cleanup": [
        "/bin"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://luajit.org/git/luajit.git",
          "branch": "v2.1"
        }
      ]
    },
    {
      "name": "mpv",
      "buildsystem": "meson",
      "config-opts": [
        "-Dlibmpv=true",
        "-Dcplayer=true",
        "-Dlua=enabled"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/mpv-player/mpv.git",
          "tag": "v0.38.0"
        }
      ]
    },
    {
      "name": "python3-dependencies",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-index --find-links=\"file://${PWD}\" --prefix=/app python-mpv PyOpenGL curl_cffi pycryptodome requests"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/source/p/python-mpv/python-mpv-1.0.7.tar.gz",
          "sha256": "443c5b8b933a39e80f2d56a29d5b49749ef154b2006ff2d250c6ca716b509f6e"
        },
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/source/P/PyOpenGL/PyOpenGL-3.1.7.tar.gz",
          "sha256": "62eb74aa2d6b38c0379201f11c750ef944b209a3fc9187313a7c644efb5ef6bc"
        }
      ]
    },
    {
      "name": "kinema",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "dir",
          "path": ".."
        }
      ]
    }
  ]
}
