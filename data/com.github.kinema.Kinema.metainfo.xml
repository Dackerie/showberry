  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Kinema</name>
  <summary>Browse and play movies</summary>
  <description>
    <p>
      Kinema is a movie browser and player for GNOME. It uses TMDB for movie
      metadata and supports multiple streaming providers with MPV playback.
    </p>
    <p>Features:</p>
    <ul>
      <li>Browse trending and popular movies from TMDB</li>
      <li>Search for any movie by title</li>
      <li>Play movies using MPV with hardware acceleration</li>
      <li>Multiple streaming provider support</li>
      <li>Clean, adaptive GNOME interface</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.github.kinema.Kinema.desktop</launchable>
