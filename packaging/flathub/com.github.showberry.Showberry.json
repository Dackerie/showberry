{
  "app-id": "com.github.showberry.Showberry",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "showberry",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--socket=pulseaudio",
    "--share=network",
    "--talk-name=org.freedesktop.Notifications",
    "--filesystem=xdg-cache/showberry:create",
    "--filesystem=xdg-data/showberry:create"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "luajit",
      "no-autogen": true,
      "cleanup": [
        "/bin"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://luajit.org/git/luajit.git",
          "branch": "v2.1"
        }
      ]
    },
    {
      "name": "mpv",
      "buildsystem": "meson",
      "config-opts": [
        "-Dlibmpv=true",
        "-Dcplayer=true",
        "-Dlua=enabled"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/mpv-player/mpv.git",
          "tag": "v0.38.0"
        }
      ]
    },
    "python3-dependencies.json",
    {
      "name": "showberry",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-deps --prefix=/app .",
        "install -Dm644 data/com.github.showberry.Showberry.desktop /app/share/applications/com.github.showberry.Showberry.desktop",
        "install -Dm644 data/com.github.showberry.Showberry.metainfo.xml /app/share/metainfo/com.github.showberry.Showberry.metainfo.xml",
        "install -Dm644 data/com.github.showberry.Showberry.gschema.xml /app/share/glib-2.0/schemas/com.github.showberry.Showberry.gschema.xml",
        "glib-compile-schemas /app/share/glib-2.0/schemas",
        "mkdir -p /app/share/icons && cp -r data/icons/* /app/share/icons/ 2>/dev/null || true"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/Dackerie/showberry/archive/refs/tags/v0.1.0.tar.gz",
          "sha256": "5eba138636ecd5adbd7003ea10677c91e3cf7aab46532ebb2a8a24da36da1b6d"
        }
      ]
    }
  ]
}
