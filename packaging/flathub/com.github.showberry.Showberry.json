{
  "app-id": "com.github.showberry.Showberry",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "showberry",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--socket=pulseaudio",
    "--share=network",
    "--talk-name=org.freedesktop.Notifications",
    "--filesystem=xdg-cache/showberry:create",
    "--filesystem=xdg-data/showberry:create"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "luajit",
      "no-autogen": true,
      "cleanup": [
        "/bin"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://luajit.org/git/luajit.git",
          "branch": "v2.1"
        }
      ]
    },
    {
      "name": "mpv",
      "buildsystem": "meson",
      "config-opts": [
        "-Dlibmpv=true",
        "-Dcplayer=true",
        "-Dlua=enabled"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/mpv-player/mpv.git",
          "tag": "v0.38.0"
        }
      ]
    },
    {
      "name": "python3-dependencies",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-index --find-links=\"file://${PWD}\" --prefix=/app python-mpv PyOpenGL curl_cffi pycryptodome requests"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/source/p/python-mpv/python-mpv-1.0.7.tar.gz",
          "sha256": "443c5b8b933a39e80f2d56a29d5b49749ef154b2006ff2d250c6ca716b509f6e"
        },
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/source/P/PyOpenGL/PyOpenGL-3.1.7.tar.gz",
          "sha256": "62eb74aa2d6b38c0379201f11c750ef944b209a3fc9187313a7c644efb5ef6bc"
        }
      ]
    },
    {
      "name": "showberry",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-deps --prefix=/app .",
        "install -Dm644 data/com.github.showberry.Showberry.desktop /app/share/applications/com.github.showberry.Showberry.desktop",
        "install -Dm644 data/com.github.showberry.Showberry.metainfo.xml /app/share/metainfo/com.github.showberry.Showberry.metainfo.xml",
        "install -Dm644 data/com.github.showberry.Showberry.gschema.xml /app/share/glib-2.0/schemas/com.github.showberry.Showberry.gschema.xml",
        "glib-compile-schemas /app/share/glib-2.0/schemas",
        "mkdir -p /app/share/icons && cp -r data/icons/* /app/share/icons/ 2>/dev/null || true"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/Dackerie/showberry/archive/refs/tags/v0.1.0.tar.gz",
          "sha256": "011ff4ce5b8b2b9c8f8210d4ef1b94df2b0f54e9146eef6fd06ca284a6da5f82"
        }
      ]
    }
  ]
}
